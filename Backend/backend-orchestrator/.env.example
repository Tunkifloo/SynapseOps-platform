# ══════════════════════════════════════════════════════════════════════════════
# SynapseOps — backend-orchestrator
# Copia como .env y rellena los valores. NUNCA commitear el .env real.
# ══════════════════════════════════════════════════════════════════════════════

# ── Servidor ──────────────────────────────────────────────────────────────────
SERVER_PORT=8080

# ── PostgreSQL ────────────────────────────────────────────────────────────────
# dev  → jdbc:postgresql://localhost:5433/orchestrator  (Docker en 5433)
# prod → jdbc:postgresql://postgres-db:5432/orchestrator (red Docker Compose)
DB_URL=jdbc:postgresql://localhost:5433/orchestrator
DB_USERNAME=
DB_PASSWORD=

# ── JWT ───────────────────────────────────────────────────────────────────────
# Generar: openssl rand -hex 32
JWT_SECRET=
JWT_EXPIRATION=36000000

# ── Admin por defecto (DatabaseSeeder) ────────────────────────────────────────
ADMIN_USERNAME=superadmin
ADMIN_PASSWORD=
ADMIN_EMAIL=admin@synapseops.pe

# ── Kafka ─────────────────────────────────────────────────────────────────────
# dev  → localhost:9092 o localhost:9094 (según configuración de Kafka en Docker)
# prod → kafka-broker:9092  (nombre del servicio en docker-compose.yml)
KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# ── MLflow ────────────────────────────────────────────────────────────────────
# dev  → http://localhost:5000
# prod → http://mlflow-server:5000  (nombre del servicio en docker-compose.yml)
MLFLOW_TRACKING_URI=http://localhost:5000

# ── Storage ───────────────────────────────────────────────────────────────────
# dev  → ./storage-dev  (carpeta local)
# prod → /storage       (volumen Docker montado en el contenedor)
STORAGE_BASE_PATH=./storage-dev
STORAGE_MAX_FILE_SIZE_MB=500

# Model service
MODEL_SERVICE_TEMPLATE_DIR=/app/model-service-template
MAX_MODEL_DEPLOYMENTS:3

# Perfil activo (dev | prod)
SPRING_PROFILES_ACTIVE=dev