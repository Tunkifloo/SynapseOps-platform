# ═══════════════════════════════════════════════════════════════════
# SynapseOps — Root .env  (leído por Docker Compose)
# Solo variables de infraestructura. NUNCA commitear este archivo.
# ═══════════════════════════════════════════════════════════════════

# ── PostgreSQL ────────────────────────────────────────────────────
DB_USERNAME=postgres
DB_PASSWORD=280410
# Puerto expuesto al HOST — 5433 evita conflicto si tienes postgres local
POSTGRES_EXTERNAL_PORT=5433

# ── Kafka KRaft ───────────────────────────────────────────────────
# Generar uno propio: openssl rand -base64 16  (exactamente 22 chars base64)
KAFKA_CLUSTER_ID=MkU3OEVBNTcwNTJENDM2Qk

# ── Grafana ───────────────────────────────────────────────────────
GRAFANA_USER=admin
GRAFANA_PASSWORD=admin123

# SPRING BOOT
# Generar con: openssl rand -hex 32
JWT_SECRET=586E3272357538782F413F4428472B4B6250655368566B597033733676397924
JWT_EXPIRATION=36000000

# ── Admin por defecto (DatabaseSeeder) ────────────────────────
ADMIN_USERNAME=superadmin
ADMIN_PASSWORD=admin123!
ADMIN_EMAIL=admin@default.pe

# ── Gitea Actions  ────────────────────────
RUNNER_TOKEN=placeholder

# Storage — leídas por docker compose para el backend-orchestrator.
# (El .env de Backend/backend-orchestrator NO llega al contenedor; estas sí.)
STORAGE_MAX_FILE_SIZE_MB=1000
STORAGE_MAX_WORKSPACE_MB=2000

# ── Límites de memoria de contenedores (Fase 0 · optimización) ────
# Acotan la RAM por servicio. Los defaults (en docker-compose.yml) están pensados para
# NO limitar en hosts de 8 GB (donde la VM de WSL2 es menor que el límite → sin regresión)
# y SÍ acotar en labs de 16 GB+. Para que rindan en labs, configura PRIMERO el .wslconfig
# (infra/wsl/wslconfig.example) y da ~75-85% de la RAM física a la VM de WSL2.
# En hosts de 16 GB+ (VM de WSL2 con ≥14 GB) puedes subir a 13g para datasets grandes.
ML_ENGINE_MEM_LIMIT=13g
BACKEND_MEM_LIMIT=2g

APP_VERSION=latest
REGISTRY=ghcr.io/tunkifloo

# ── Documentación de la API (Swagger UI / OpenAPI) ─────────────────
# El perfil `prod` (el que usa docker compose) desactiva Swagger por seguridad.
# Esta variable lo reactiva para el laboratorio: con `true` quedan disponibles
#   http://localhost:8080/swagger-ui.html   y   http://localhost:8080/api-docs
# Si se quita la variable, el default de docker-compose.yml es `false` (endurecido).
SWAGGER_ENABLED=true
