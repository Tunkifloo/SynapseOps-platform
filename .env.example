# ══════════════════════════════════════════════════════════════
# SynapseOps — backend-orchestrator — Variables de entorno
# Copia este archivo como .env y rellena los valores reales.
# NUNCA commitas el .env al repositorio.
# ══════════════════════════════════════════════════════════════

# ── Servidor ──────────────────────────────────────────────────
SERVER_PORT=8080

# ── PostgreSQL ────────────────────────────────────────────────
# Desarrollo local (backend en IntelliJ, postgres en Docker):
DB_URL=jdbc:postgresql://localhost:5432/orchestrator
# Producción (backend en contenedor dentro de la red Docker Compose):
# DB_URL=jdbc:postgresql://postgres-db:5432/orchestrator
DB_USERNAME=postgres
DB_PASSWORD=

# ── JWT ───────────────────────────────────────────────────────
# Generar con: openssl rand -hex 32
JWT_SECRET=
JWT_EXPIRATION=36000000

# ── Admin por defecto (DatabaseSeeder) ────────────────────────
ADMIN_USERNAME=superadmin
ADMIN_PASSWORD=
ADMIN_EMAIL=admin@synapseops.pe

# ── Kafka ─────────────────────────────────────────────────────
# Desarrollo local: localhost:9092
# Producción (contenedor): kafka-broker:9092
KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# ── MLflow ────────────────────────────────────────────────────
# Desarrollo local: http://localhost:5000
# Producción (contenedor): http://mlflow-server:5000
MLFLOW_TRACKING_URI=http://localhost:5000