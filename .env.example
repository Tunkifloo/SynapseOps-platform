# ── PostgreSQL ────────────────────────────────────────────────────
DB_USERNAME=postgres
DB_PASSWORD=280410
# Puerto expuesto al HOST — 5433 evita conflicto si tienes postgres local
POSTGRES_EXTERNAL_PORT=5433

# ── Kafka KRaft ───────────────────────────────────────────────────
# Generar uno propio: openssl rand -base64 16  (exactamente 22 chars base64)
KAFKA_CLUSTER_ID=MkU3OEVBNTcwNTJENDM2Qk

# ── Grafana ───────────────────────────────────────────────────────
GRAFANA_USER=admin
GRAFANA_PASSWORD=admin123